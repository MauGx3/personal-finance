# Copy to .env and fill in. Never commit .env.

# Required in production: a long random string.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Host names or IPs the app is reached at, comma separated (your NAS address).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when behind a reverse proxy, e.g. https://finance.example.home
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to true only when a reverse proxy serves the app over HTTPS.
HTTPS=false

# Currency for totals, and the local time zone.
BASE_CURRENCY=BRL
TIME_ZONE=America/Sao_Paulo

# Optional. Default is a SQLite file in the data volume.
# DATABASE_URL=postgres://user:password@host:5432/personal_finance

# Docker only: published port and seconds between price syncs (default 6 hours).
PORT=8000
PRICE_SYNC_INTERVAL_SECONDS=21600
