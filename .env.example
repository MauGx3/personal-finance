# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production-use-at-least-50-random-characters
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DATABASE_URL=postgresql://personal_finance_user:personal_finance_password@localhost:5432/personal_finance_db
# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1


# Static and Media


# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, use:
# EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
# ANYMAIL_MAILGUN_API_KEY=your-api-key
# ANYMAIL_MAILGUN_SENDER_DOMAIN=mg.example.com
DEFAULT_FROM_EMAIL=personal_finance@example.com
SERVER_EMAIL=personal_finance@example.com

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1


# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=personal_finance
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp


# JWT
JWT_ACCESS_TOKEN_LIFETIME=5  # minutes
JWT_REFRESH_TOKEN_LIFETIME=1440  # minutes (24 hours)




# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=False


# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False


# CORS (for frontend development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
