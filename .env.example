# Database Configuration
# Set your PostgreSQL connection string here
# Format: postgresql://username:password@host:port/database

# For local development (PostgreSQL)
# Example environment variables for deploying via Portainer stack
# Copy this file to .env and edit values before deploying, or set secrets in Portainer

# -------------------------------
# Database (Postgres)
# -------------------------------
# Postgres user/password/database for the DB container
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance

# Optional: full DATABASE_URL (overrides POSTGRES_* values when present)
# Format: postgresql+psycopg2://username:password@host:port/database
# Example: postgresql+psycopg2://finance:finance@db:5432/finance
DATABASE_URL=postgresql+psycopg2://finance:finance@db:5432/finance

# -------------------------------
# Application
# -------------------------------
PORT=8000

# Django settings module to use in production
DJANGO_SETTINGS_MODULE=config.settings.production

# Control whether migrations/run on container start (1 = run)
RUN_MIGRATIONS_ON_START=1
USE_DOCKER=yes

# Notes:
# - Do NOT commit real secrets; when deploying with Portainer, prefer using Portainer
#   secrets or environment variables configured in the Portainer UI rather than storing
#   credentials in this file.
# - If you prefer to use an external database, set DATABASE_URL accordingly and remove
#   the 'db' service from the stack file.

# For production, set DATABASE_URL via environment variable instead of committing secrets.

# Example production URL:
# DATABASE_URL=postgresql://user:password@your-host.com:5432/personal_finance_db

# If DATABASE_URL is unset, the application will FALL BACK to a local SQLite
# file database at: sqlite:///personal_finance.db
# (Good for quick tests / notebooks without Postgres running.)

# For production, set DATABASE_URL via environment variable instead of committing secrets.

# Example production URL:
# DATABASE_URL=postgresql://user:password@your-host.com:5432/personal_finance_db
