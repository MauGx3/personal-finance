#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# Be tolerant with environment variables. Portainer may provide DATABASE_URL directly
# or individual POSTGRES_* variables. Provide sensible defaults and parse DATABASE_URL
# if needed so we don't get "unbound variable" errors.

# If DATABASE_URL is not set, build it from POSTGRES_* env vars (with defaults)
if [ -z "${DATABASE_URL:-}" ]; then
    POSTGRES_USER=${POSTGRES_USER:-postgres}
    POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-}
    POSTGRES_HOST=${POSTGRES_HOST:-db}
    POSTGRES_PORT=${POSTGRES_PORT:-5432}
    POSTGRES_DB=${POSTGRES_DB:-${POSTGRES_USER}}

    export POSTGRES_USER POSTGRES_PASSWORD POSTGRES_HOST POSTGRES_PORT POSTGRES_DB
    export DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"
else
    # Parse host and port from DATABASE_URL for wait-for-it
    # DATABASE_URL format: scheme://user:pass@host:port/db or scheme://user:pass@host/db
    POSTGRES_HOST=$(echo "${DATABASE_URL}" | sed -nE 's|.*@([^:/]+)(:([0-9]+))?/.*|\1|p')
    POSTGRES_PORT=$(echo "${DATABASE_URL}" | sed -nE 's|.*@[^:/]+:([0-9]+)/.*|\1|p' || true)
    if [ -z "${POSTGRES_PORT:-}" ]; then
      POSTGRES_PORT=5432
    fi
    export POSTGRES_HOST POSTGRES_PORT
fi

wait-for-it "${POSTGRES_HOST}:${POSTGRES_PORT}" -t 30

>&2 echo 'PostgreSQL is available'

exec "$@"
