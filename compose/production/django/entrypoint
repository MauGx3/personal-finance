#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

if [ -z "${POSTGRES_USER}" ]; then
    base_postgres_image_default_user='postgres'
    export POSTGRES_USER="${base_postgres_image_default_user}"
fi
export DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Use pg_isready to check for a ready Postgres server instead of raw TCP probes.
# Use exponential backoff between attempts to reduce continuous probe noise.
RETRIES=8
SLEEP_BASE=1
SLEEP_MAX=30
count=0
until pg_isready -h "${POSTGRES_HOST}" -p "${POSTGRES_PORT}" -U "${POSTGRES_USER}" >/dev/null 2>&1; do
    count=$((count + 1))
    if [ ${count} -ge ${RETRIES} ]; then
        >&2 echo "Postgres did not become ready after ${RETRIES} attempts"
        exit 1
    fi
    # exponential backoff: min(SLEEP_MAX, SLEEP_BASE * 2^(count-1))
    sleep_time=$(( SLEEP_BASE * (1 << (count - 1)) ))
    if [ ${sleep_time} -gt ${SLEEP_MAX} ]; then
        sleep_time=${SLEEP_MAX}
    fi
    >&2 echo "pg_isready failed, sleeping ${sleep_time}s (attempt ${count}/${RETRIES})"
    sleep ${sleep_time}
done

>&2 echo 'PostgreSQL is available'

exec "$@"
