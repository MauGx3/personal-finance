### Leapcell stack env example
# Copy this file into Leapcell's environment variables UI or use it as a template.
# DO NOT commit real secrets to the repository. Replace placeholders before use.

# Django/Project
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-this-with-a-secure-secret

# Database (example placeholder)
# Replace with your actual DATABASE_URL. Example form:
# postgres://<USER>:<PASSWORD>@<HOST>:<PORT>/<NAME>?sslmode=require
DATABASE_URL=postgres://<USER>:<PASSWORD>@<HOST>:<PORT>/<NAME>?sslmode=require

# Optional/Recommended
# Redis (if used): REDIS_URL=redis://redis:6379/0
# Sentry (optional): SENTRY_DSN=
# Any other envs required by your production settings
