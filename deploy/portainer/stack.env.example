# Example env file for deploying the Personal Finance stack via Portainer (stack deploy)
# Copy this into Portainer's "Environment variables" or upload as a .env file when creating a stack.

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-this-with-a-secure-secret

# Database (set host to the external Postgres host if using a managed DB)
# Format examples:
# DATABASE_URL=postgresql+psycopg2://finance:finance@db:5432/finance  # use internal container port for stack services
# DATABASE_URL=postgresql+psycopg2://finance:finance@db:52135/finance # host-mapped port (only if connecting from the host)
DATABASE_URL=postgresql+psycopg2://finance:finance@db:5432/finance

# Optional runtime toggles
RUN_MIGRATIONS_ON_START=1
USE_DOCKER=yes

# Port mapping for the host-side app port (Portainer will publish the port)
PORT=8000
