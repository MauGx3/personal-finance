# Portainer stack.env placeholder
# This file must exist in the repository for Portainer's "Deploy from repository" flow.
# Do NOT commit real secrets. For production, use Portainer secrets or set the envs in the UI.

# Database credentials
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance

# Optional: full DATABASE_URL (overrides POSTGRES_* values when present)
# Example: postgresql+psycopg2://finance:finance@db:5432/finance
DATABASE_URL=postgresql+psycopg2://finance:finance@db:5432/finance

# Application
PORT=8000
DJANGO_SETTINGS_MODULE=config.settings.production
RUN_MIGRATIONS_ON_START=1
USE_DOCKER=yes
